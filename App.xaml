<Application x:Class="RepoNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RepoNotes.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Suppress WPF's default dotted keyboard focus adorner globally (including sticky notes and Alt+Tab) -->
            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
            <conv:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlowDocumentConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

