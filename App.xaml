<Application x:Class="RepoNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RepoNotes.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
            <conv:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlowDocumentConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

