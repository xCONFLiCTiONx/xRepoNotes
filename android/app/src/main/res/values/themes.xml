<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.XRepoNotes" parent="android:Theme.Material.NoActionBar">
        <!-- Dark Window Background (prevents white launch screen) -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>

        <!-- Android 12+ System Splash Screen Dark Theme -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/dark_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>

        <!-- Dark System Bars -->
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>