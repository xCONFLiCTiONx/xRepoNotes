<Window x:Class="RepoNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepoNotes" Width="1020" Height="620" MinWidth="720" MinHeight="440"
        Icon="/xRepoNotes;component/icons/icon.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        Opacity="0"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Sticky note card -->
        <DataTemplate x:Key="NoteCard">
            <Border Width="300" Height="275" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1"
                    Background="{Binding CardBrush}" BorderBrush="{StaticResource Border}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentBrush}" CornerRadius="7,7,0,0"/>

                    <DockPanel Grid.Row="1" Margin="10,6,6,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Left-click: Copy displayed text&#x0a;Right-click: Copy raw markdown"
                                    Click="CopyNote_Click" MouseRightButtonUp="CopyNote_MouseRightButtonUp" Padding="6"/>
                            <Button Style="{StaticResource GhostButton}" Content="✦" ToolTip="Format with AI (Markdown)"
                                    Padding="6,3" FontSize="14" Click="Ai_Click" Foreground="{StaticResource Accent}"/>
                            <Button Style="{StaticResource IconButton}" Content="{Binding QuickEditIcon}" ToolTip="{Binding QuickEditToolTip}"
                                    Click="ToggleQuickEdit_Click" Padding="6"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Open in large editor" Click="Expand_Click" Padding="6"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete note" Click="Delete_Click" Padding="6"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Left" CornerRadius="8" Padding="7,2" Background="{Binding ChipBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RepoLabel}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"
                                           FontSize="11.5" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- Card Body Area: Rendered View vs Inline Quick Edit -->
                    <Grid Grid.Row="2" Margin="8,4,6,2">
                        <!-- Rendered Markdown View (Default) -->
                        <Grid Visibility="{Binding IsEditingInline, Converter={StaticResource InverseBoolToVis}}"
                              Background="Transparent">
                            <FlowDocumentScrollViewer x:Name="CardViewer"
                                                      Document="{Binding Body, Converter={StaticResource MarkdownToFlowDocumentConverter}}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsToolBarVisible="False"
                                                      IsSelectionEnabled="True"
                                                      Focusable="True"
                                                      PreviewMouseLeftButtonDown="CardViewer_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="CardViewer_PreviewMouseMove"
                                                      PreviewMouseLeftButtonUp="CardViewer_PreviewMouseLeftButtonUp"
                                                      LostMouseCapture="CardViewer_LostMouseCapture"
                                                      RequestBringIntoView="CardViewer_RequestBringIntoView"
                                                      ContextMenuOpening="CardViewer_ContextMenuOpening">
                                <FlowDocumentScrollViewer.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Copy" Header="Copy"/>
                                        <MenuItem Command="ApplicationCommands.SelectAll" Header="Select All"/>
                                        <Separator/>
                                        <MenuItem Header="Move to Vault" Click="CardMoveVault_Click"/>
                                    </ContextMenu>
                                </FlowDocumentScrollViewer.ContextMenu>
                            </FlowDocumentScrollViewer>
                            <TextBlock Text="Empty note — click to edit"
                                       Style="{StaticResource Dim}"
                                       FontStyle="Italic"
                                       Margin="4,4,0,0"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="EmptyNote_MouseLeftButtonDown"
                                       Visibility="{Binding HasBody, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>

                        <!-- Raw Markdown Textbox (Quick Edit Mode) -->
                        <Grid Visibility="{Binding IsEditingInline, Converter={StaticResource BoolToVis}}">
                            <TextBox x:Name="InlineBodyBox" Style="{StaticResource BareTextBox}" Padding="4,0,0,0"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     IsVisibleChanged="InlineBodyBox_IsVisibleChanged"
                                     PreviewKeyDown="InlineBodyBox_PreviewKeyDown"/>
                            <TextBlock Text="Note content…" Style="{StaticResource Dim}" FontFamily="Consolas" FontSize="12"
                                       Margin="4,0,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding HasBody, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="12,0,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding VaultActionText}"
                                ToolTip="{Binding VaultActionToolTip}" Padding="6,2" FontSize="11" Click="CardMoveVault_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Undo AI" Padding="5,2" FontSize="11"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" Click="Undo_Click"/>
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Busy overlay -->
                    <Border Grid.RowSpan="4" Background="{StaticResource Scrim}" CornerRadius="8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="12"/>
                            <ProgressBar IsIndeterminate="True" Width="170"/>
                            <Button Content="Cancel" Margin="0,12,0,0" HorizontalAlignment="Center" Click="CancelAi_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SidebarItem">
            <Grid ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Dim}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0}">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="icons/icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="RepoNotes" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1" MaxWidth="380" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                    <TextBox x:Name="SearchBox" Padding="10,5,26,5" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" Width="260"/>
                    <TextBlock x:Name="SearchHint" Text="Search notes…" Style="{StaticResource Dim}" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                            ToolTip="Clear search (Esc)" Visibility="Collapsed" Click="ClearSearch_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4" Width="22" Height="22"/>
                </Grid>
                <Button x:Name="SyncButton" Grid.Column="2" Content="⟳  Sync" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        VerticalAlignment="Center" Padding="10,6" Click="ManualSync_Click"/>
                <Button Grid.Column="3" Content="＋  New note" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        VerticalAlignment="Center" Padding="12,6" Click="NewNote_Click"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                        VerticalAlignment="Center" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarRoot" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="10,10,10,4" Padding="8" CornerRadius="6" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="NOTEBOOKS" Style="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <Button x:Name="PersonalNotebookButton" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,4" Click="PersonalMode_Click"
                                    ToolTip="Personal Notebook">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📓" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Personal Notebook" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WorkNotebookButton" HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,4" Click="WorkMode_Click"
                                    ToolTip="Work Notebook">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💼" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Work Notebook" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="VaultButton" HorizontalContentAlignment="Left" Padding="8,6" Click="VaultMode_Click"
                                    ToolTip="Open Vault (private &amp; long-term notes)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vault" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="10,4,10,4" Padding="8" CornerRadius="6" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open…" Padding="6,2" FontSize="11.5"
                                        Foreground="{StaticResource Accent}" ToolTip="Open a file from disk (Ctrl+O)" Click="OpenFile_Click"/>
                                <TextBlock Text="FILE EDITOR" Style="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button x:Name="FileEditorTabButton" HorizontalContentAlignment="Left" Padding="8,6" Click="FileEditorTab_Click"
                                    ToolTip="Switch to File Editor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FileEditorTabLabel" Text="File Editor" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="140" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid x:Name="ProjectsSection" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PROJECTS" Style="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="14,8,0,6"/>
                        <ProgressBar x:Name="ScanBar" Grid.Row="1" IsIndeterminate="True" Margin="14,0,14,6" Height="2" Visibility="Collapsed"/>
                        <TextBox x:Name="RepoFilter" Grid.Row="2" Margin="10,0,10,6" Padding="8,4" TextChanged="RepoFilter_TextChanged"
                                 ToolTip="Filter projects" FontSize="12"/>
                        <ListBox x:Name="RepoList" Grid.Row="3" ItemTemplate="{StaticResource SidebarItem}" SelectionChanged="RepoList_SelectionChanged"/>
                        <Border x:Name="NoRootHint" Grid.Row="4" Margin="10" Padding="10" CornerRadius="6" Background="{StaticResource Bg2}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="NoRootText" TextWrapping="Wrap" FontSize="11.5"
                                           Text="Select your main repos directory in Settings to list git projects."/>
                                <Button Content="Open settings" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,4" FontSize="11.5" Click="Settings_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">
                <!-- Dashboard -->
                <Grid x:Name="DashboardRoot">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="20,16,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ViewTitle" FontSize="18" FontWeight="SemiBold" Text="All notes"/>
                            <TextBlock x:Name="ViewCount" Style="{StaticResource Dim}" FontSize="12.5" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Border x:Name="VaultModeSwitch" Grid.Column="1" Margin="16,0,0,0" CornerRadius="6"
                                Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                Padding="2" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VaultPersonalButton" Content="Personal" Padding="10,4" FontSize="12"
                                        BorderThickness="0" Click="VaultPersonalMode_Click"/>
                                <Button x:Name="VaultWorkButton" Content="Work" Padding="10,4" FontSize="12"
                                        BorderThickness="0" Margin="2,0,0,0" Click="VaultWorkMode_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="DashScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4,12,8" SizeChanged="DashScroll_SizeChanged">
                        <ItemsControl x:Name="NotesList" ItemTemplate="{StaticResource NoteCard}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="No notes here yet" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Press “New note” to add one" Style="{StaticResource Dim}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Large editor -->
                <Grid x:Name="EditorRoot" Visibility="Collapsed" Background="{StaticResource Bg0}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CloseEditorButton" Style="{StaticResource GhostButton}" Content="←  Dashboard" Click="CloseEditor_Click" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="17" FontWeight="SemiBold" Margin="12,0"
                                     VerticalAlignment="Center" MaxLength="200" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox x:Name="RepoCombo" Grid.Column="2" Width="190" DisplayMemberPath="Name" SelectedValuePath="Path"
                                      SelectedValue="{Binding RepoPath, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Project this note belongs to"/>
                            <Button x:Name="MoveVaultButton" Grid.Column="3" Style="{StaticResource GhostButton}" Content="🔒  Move to Vault" Margin="8,0,0,0" Click="MoveVault_Click"/>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Paste image" Margin="8,0,0,0" Click="PasteImage_Click"
                                    ToolTip="Paste an image from the clipboard (Ctrl+V)"/>
                            <Button Grid.Column="5" Content="Undo AI" Margin="8,0,0,0" Click="Undo_Click"
                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="6" Content="✦  Format with AI" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ai_Click"/>
                            <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete note" Margin="4,0,0,0" Click="Delete_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditorBox" Style="{StaticResource BareTextBox}" Padding="18,14" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="EditorBox_TextChanged"
                                 PreviewKeyDown="EditorBox_PreviewKeyDown"/>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
                        <Border Grid.Column="2" Background="{StaticResource Bg1}">
                            <FlowDocumentScrollViewer x:Name="Preview" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
                        </Border>
                    </Grid>

                    <Border Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BusyText}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <ProgressBar IsIndeterminate="True" Width="220"/>
                            <Button Content="Cancel" Margin="0,14,0,0" HorizontalAlignment="Center" Click="CancelAi_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- File Editor -->
                <Grid x:Name="FileEditorRoot" Visibility="Collapsed" Background="{StaticResource Bg0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Content="←  Notes" Click="CloseFileEditor_Click" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FileEditorTitle" Text="No file open" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="FileEditorPathText" Text="Open a file or drag &amp; drop one here" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open file…" Margin="8,0,0,0" Click="OpenFile_Click" ToolTip="Open file (Ctrl+O)"/>
                            <Button x:Name="FileReloadButton" Grid.Column="3" Style="{StaticResource GhostButton}" Content="Reload" Margin="6,0,0,0" Click="ReloadFile_Click" IsEnabled="False"/>
                            <Button x:Name="FilePreviewToggleButton" Grid.Column="4" Style="{StaticResource GhostButton}" Content="Preview" Margin="6,0,0,0" Click="FilePreviewToggle_Click"/>
                            <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="Save As…" Margin="6,0,0,0" Click="SaveFileAs_Click"/>
                            <Button x:Name="FileSaveButton" Grid.Column="6" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveFile_Click" ToolTip="Save file (Ctrl+S)"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="FilePreviewSplitterCol" Width="0"/>
                            <ColumnDefinition x:Name="FilePreviewCol" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FileEditorBox" Style="{StaticResource BareTextBox}" Padding="18,14" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 TextChanged="FileEditorBox_TextChanged"/>
                        <GridSplitter x:Name="FilePreviewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}" Visibility="Collapsed"/>
                        <Border x:Name="FilePreviewBorder" Grid.Column="2" Background="{StaticResource Bg1}" Visibility="Collapsed">
                            <FlowDocumentScrollViewer x:Name="FilePreview" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,5">
                        <DockPanel>
                            <TextBlock x:Name="FileStatusRight" DockPanel.Dock="Right" Style="{StaticResource Dim}" FontSize="11.5" Text="UTF-8"/>
                            <TextBlock x:Name="FileStatusLeft" Style="{StaticResource Dim}" FontSize="11.5" Text="Ready"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
